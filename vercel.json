{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/css/(.*)", "destination": "/src/css/$1" },
    { "source": "/javascript/(.*)", "destination": "/src/javascript/$1" },
    { "source": "/contenido/(.*)", "destination": "/src/contenido/$1" },
    { "source": "/img/(.*)", "destination": "/src/img/$1" },
    { "source": "/(.*)", "destination": "/index.js" }
  ]
}